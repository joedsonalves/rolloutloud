<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RolloutLoud.App.AvaloniaApp"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button.launch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Elevated launches are visually distinct on purpose. These buttons start an agent with
         every approval prompt turned off, and the operator has to be able to tell at a glance
         which half of the pair they are about to click. -->
    <Style Selector="Button.elevated">
      <Setter Property="Background" Value="#4A1F1F" />
      <Setter Property="BorderBrush" Value="#B4433A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.elevated:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5E2626" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1C1C1F" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Application.Styles>

</Application>
