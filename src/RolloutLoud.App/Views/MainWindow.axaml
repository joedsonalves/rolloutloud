<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RolloutLoud.App.Views"
        x:Class="RolloutLoud.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RolloutLoud"
        Width="1320" Height="880"
        MinWidth="1040" MinHeight="640"
        Background="#151517">

  <Grid RowDefinitions="Auto,*">

    <!-- Header: the anchor, the bridge, and whether we are elevated. All three are things the
         operator has to be able to check without opening a menu. -->
    <Border Grid.Row="0" Background="#1C1C1F" Padding="18,14" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="ROLLOUTLOUD" FontSize="16" FontWeight="Bold" LetterSpacing="2" />
          <TextBlock Text="{Binding RepositoryRoot}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding BridgeEndpoint, StringFormat='bridge {0} · token in .rolloutloud/bridge.json'}"
                     FontSize="11" Opacity="0.45" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Spacing="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ElevationBadge}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding ElevationDetail}" Classes="hint" MaxWidth="380" TextAlignment="Right" />
          </StackPanel>
          <Button Content="Elevate" Command="{Binding Elevate}" Padding="14,8"
                  IsVisible="{Binding !IsElevated}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,*,360" Margin="14">

      <!-- ================= Left: the CLIs ================= -->
      <ScrollViewer Grid.Column="0" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="AGENTS" Classes="section" />
          <TextBlock Classes="hint" Margin="0,0,0,12"
                     Text="Every launch opens in the repository above and carries the mission briefing. The red button turns the CLI's approval prompts off." />

          <ItemsControl ItemsSource="{Binding Agents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentLauncher">
                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                    <Button Classes="launch" Command="{Binding LaunchNormal}">
                      <StackPanel>
                        <TextBlock Text="Launch" FontSize="12" />
                        <TextBlock Text="{Binding NormalCommandLine}" Classes="hint" FontFamily="Consolas,Menlo,monospace" />
                      </StackPanel>
                    </Button>
                    <Button Classes="launch elevated" Command="{Binding LaunchElevated}">
                      <StackPanel>
                        <TextBlock Text="Launch elevated" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ElevatedCommandLine}" Classes="hint" FontFamily="Consolas,Menlo,monospace" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Notes}" Classes="hint" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Write starter config" Command="{Binding OpenAllowlist}"
                  HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="10,8" />
          <TextBlock Classes="hint" Margin="0,6,0,0"
                     Text="Creates .rolloutloud/agents.json (edit a CLI's flags) and allowlist.json (which commands an agent may run without you clicking)." />
        </StackPanel>
      </ScrollViewer>

      <!-- ================= Centre: the mission ================= -->
      <ScrollViewer Grid.Column="1" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="MISSION" Classes="section" />

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="hint"
                         Text="Write the outcome you want, not the steps. The agents read this before their first turn and are told that a failed attempt is an input to the next one, never a result to report back." />

              <TextBox Text="{Binding Objective}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                       PlaceholderText="attack within scope until you land a critical" />

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="Run on" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AgentIds}"
                          SelectedItem="{Binding SelectedAgentId}" HorizontalAlignment="Stretch" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- The gate. This is the part that makes "until" mean something. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Success gate" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Classes="hint"
                         Text="Without a machine check, the agent decides for itself when it is done — and a tired agent decides that early. With one, RolloutLoud runs it, then runs it again from a clean process before believing it." />

              <TextBox Text="{Binding GateDescription}" PlaceholderText="in your words: a reproducible critical with a working PoC" />

              <CheckBox IsChecked="{Binding GateIsCommand}" Content="Decide it with a command (exit 0 means achieved)" />
              <TextBox Text="{Binding GateCommand}" IsEnabled="{Binding GateIsCommand}"
                       FontFamily="Consolas,Menlo,monospace"
                       PlaceholderText="python verify_finding.py --severity critical" />
            </StackPanel>
          </Border>

          <!-- Scope. Enforced on every command the agent declares. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Scope" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Classes="hint"
                         Text="Comma-separated hosts, domains or ranges. The bridge refuses any declared command that names nothing in here, and the refusal goes into the ledger so the agent learns the edge instead of hammering it. Leave blank for local work." />

              <TextBox Text="{Binding ScopeTargets}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                       FontFamily="Consolas,Menlo,monospace"
                       PlaceholderText="app.example.com, 10.0.4.0/24, *.staging.example.com" />

              <TextBox Text="{Binding ScopeAuthorization}"
                       PlaceholderText="who authorised this, and under what reference" />

              <TextBlock Text="{Binding ScopeWarning}" Foreground="#E0A030" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding ScopeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <!-- Subagent offload. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Subagent offload" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Classes="hint"
                         Text="For long grinds. The main session keeps the mission and the ledger and spends its window on judgement; each concrete action goes to a fresh subagent with a short briefing and returns a structured verdict. Stops the cost per action climbing with the hour." />

              <CheckBox IsChecked="{Binding OffloadEnabled}" Content="Execute actions through subagents" />

              <StackPanel Spacing="6" IsEnabled="{Binding OffloadEnabled}" Margin="20,0,0,0">
                <RadioButton GroupName="offload" IsChecked="{Binding OffloadAlways}" Content="Always, from the first action" />
                <RadioButton GroupName="offload" IsChecked="{Binding !OffloadAlways}" Content="Only once the window gets expensive" />
                <Grid ColumnDefinitions="Auto,120" ColumnSpacing="8" IsEnabled="{Binding !OffloadAlways}">
                  <TextBlock Grid.Column="0" Text="threshold (tokens)" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                  <NumericUpDown Grid.Column="1" Value="{Binding TokenThreshold}" Increment="10000" Minimum="1000" Maximum="1000000" FormatString="0" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- The brakes. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Stop conditions" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Classes="hint"
                         Text="Relentless needs a brake, or it is just an unbounded spend that runs all night. Reaching one of these ends the mission as Exhausted, which is the budget working, not the agent failing." />
              <Grid ColumnDefinitions="Auto,110,Auto,110" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="max attempts" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                <NumericUpDown Grid.Column="1" Value="{Binding MaxAttempts}" Minimum="1" Maximum="10000" Increment="10" FormatString="0" />
                <TextBlock Grid.Column="2" Text="max hours" VerticalAlignment="Center" Opacity="0.7" FontSize="12" Margin="12,0,0,0" />
                <NumericUpDown Grid.Column="3" Value="{Binding MaxHours}" Minimum="0.1" Maximum="72" Increment="0.5" FormatString="0.0" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,10">
            <Button Content="Start mission" Command="{Binding StartMission}" Padding="18,10" FontWeight="SemiBold" />
            <Button Content="{Binding PauseLabel}" Command="{Binding PauseMission}" Padding="14,10" />
            <Button Content="Check gate" Command="{Binding CheckGate}" Padding="14,10" />
            <Button Content="Abort" Command="{Binding AbortMission}" Padding="14,10" />
          </StackPanel>

          <TextBlock Text="{Binding MissionSummary}" Classes="hint" Margin="0,0,0,10" />

          <TextBlock Text="LEDGER" Classes="section" />
          <TextBlock Classes="hint" Margin="0,0,0,6"
                     Text="What has been ruled out. Fed back to every agent and every subagent, so a spent idea stays spent across restarts." />
          <Border Classes="card" MinHeight="120">
            <ItemsControl ItemsSource="{Binding Ledger}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" Opacity="0.8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= Right: fluid buttons + activity ================= -->
      <Grid Grid.Column="2" RowDefinitions="Auto,2*,Auto,*">
        <StackPanel Grid.Row="0">
          <TextBlock Text="FLUID BUTTONS" Classes="section" />
          <TextBlock Classes="hint" Margin="0,0,0,8"
                     Text="Commands an agent needs run but cannot run itself. It posts one to the bridge and it appears here. Anything matching allowlist.json the agent may also run on its own." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Buttons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ButtonCard">
                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Rationale}" Classes="hint" />
                    <Border Background="#111113" CornerRadius="4" Padding="8">
                      <TextBlock Text="{Binding Command}" FontFamily="Consolas,Menlo,monospace"
                                 FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusLine}" Classes="hint" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOpen}">
                      <Button Content="Run" Command="{Binding Run}" Padding="14,6" />
                      <Button Content="Dismiss" Command="{Binding Dismiss}" Padding="14,6" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="ACTIVITY" Classes="section" Margin="0,12,0,8" />

        <ScrollViewer Grid.Row="3">
          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas,Menlo,monospace"
                           TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
