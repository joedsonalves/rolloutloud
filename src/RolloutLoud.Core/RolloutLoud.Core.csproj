<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core never references a UI toolkit. Not Avalonia, not WPF, not System.Drawing.
       Everything here has to be runnable from a test with no window and no display. -->
  <PropertyGroup>
    <RootNamespace>RolloutLoud.Core</RootNamespace>
  </PropertyGroup>

  <!-- One seam, for the launcher's command line. A quoting bug there cannot be caught from
       outside the process: cmd.exe starts fine and the failure appears as a dialog from `start`.
       The only way to test it is to read the string before it is handed to Windows. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RolloutLoud.Core.Tests" />
  </ItemGroup>

  <!-- WithCulture="false" and an explicit LogicalName are both load-bearing.

       `Strings.en.json` matches MSBuild's name.culture.extension pattern (`en` is a real culture),
       so by default it is compiled into a SATELLITE ASSEMBLY rather than into this one. The build
       succeeds, nothing warns, GetManifestResourceStream returns null at run time, and every
       label in the window renders as [key]. Vacuon hit this exact failure and it cost a debugging
       session, because there is no error anywhere in the chain.

       LocalizationTests fails if any of the three tables stops loading. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings.en.json" WithCulture="false" LogicalName="RolloutLoud.Core.Strings.en.json" />
    <EmbeddedResource Include="Localization\Strings.pt.json" WithCulture="false" LogicalName="RolloutLoud.Core.Strings.pt.json" />
    <EmbeddedResource Include="Localization\Strings.es.json" WithCulture="false" LogicalName="RolloutLoud.Core.Strings.es.json" />
  </ItemGroup>

</Project>
